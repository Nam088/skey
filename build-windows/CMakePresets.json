{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "SKey Windows Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../out/windows-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SKEY_BUILD_TESTS": "ON" }
    },
    {
      "name": "windows-release",
      "displayName": "SKey Windows Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../out/windows-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SKEY_BUILD_TESTS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" }
  ],
  "testPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-release", "output": { "outputOnFailure": true } }
  ]
}
