# Editor and OS noise
.DS_Store
._*
*.swp

# Downloaded release archives, and the trees unpacked from them. All three
# are reference material rather than sources of this repository: uvconv/
# duplicates src/vnconv from an older release, and windows-src-3.62/ is
# Uk362src.zip unpacked, binaries and build logs included. They stay on
# disk, they just are not history.
official_releases/
uvconv/
windows-src-3.62/

# Autotools build output. The tracked inputs are configure.ac, Makefile.am
# and Makefile.in; everything below is generated by running the build.
*.o
*.lo
*.la
.libs/
.deps/
autom4te.cache/
config.log
config.status

# The Rust port: cargo output, and the harness binaries that Makefile
# rebuilds from tracked sources.
port/target/
port/oracle/oracle
port/oracle/oracle_rust
port/oracle/ctx_harness
port/tablegen/dump
port/bench/bench_cpp
port/bench/bench_cpp_o3

# macOS IMKit host, built directly with swiftc (see macos/UniKeyIM-simple/build.sh).
# The .app bundle and the unpackaged binary are outputs, not sources.
macos/UniKeyIM-simple/UniKeyIM
macos/UniKeyIM-simple/UniKeyIM.app/
macos/UniKeyIM-simple/harness

# macOS SKey App build outputs
macos/skey-app/SKey.app/
macos/skey-app/scripts/spotlight_comprehensive_test
macos/skey-app/scripts/spotlight_sentence_tester
macos/skey-app/scripts/spotlight_speed_benchmarks
macos/skey-app/scripts/spotlight_tester
/tmp/cross_app_test_bin
