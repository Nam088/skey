# Editor and OS noise
.DS_Store
._*
*.swp

# Downloaded release archives, and the trees unpacked from them. All three
# are reference material rather than sources of this repository: uvconv/
# duplicates src/vnconv from an older release, and windows-src-3.62/ is
# Uk362src.zip unpacked, binaries and build logs included. They stay on
# disk, they just are not history.
official_releases/
uvconv/
windows-src-3.62/

# Reverse-engineered EVKey reference material (strings, PE headers,
# disassembly, architecture notes). Reference only, never committed.
evkey/

# Autotools build output. The tracked inputs are configure.ac, Makefile.am
# and Makefile.in; everything below is generated by running the build.
*.o
*.lo
*.la
.libs/
.deps/
autom4te.cache/
config.log
config.status

# The Rust port: cargo output, and the harness binaries that Makefile
# rebuilds from tracked sources.
core/target/
core/oracle/oracle
core/oracle/oracle_rust
core/oracle/ctx_harness
core/tablegen/dump
core/bench/bench_cpp
core/bench/bench_cpp_o3

# macOS IMKit host, built directly with swiftc (see platforms/macos/UniKeyIM-simple/build.sh).
# The .app bundle and the unpackaged binary are outputs, not sources.
platforms/macos/UniKeyIM-simple/UniKeyIM
platforms/macos/UniKeyIM-simple/UniKeyIM.app/
platforms/macos/UniKeyIM-simple/harness

# macOS SKey App build outputs
platforms/macos/skey-app/SKey.app/
platforms/macos/skey-app/scripts/spotlight_comprehensive_test
platforms/macos/skey-app/scripts/spotlight_sentence_tester
platforms/macos/skey-app/scripts/spotlight_speed_benchmarks
platforms/macos/skey-app/scripts/spotlight_tester
/tmp/cross_app_test_bin
dist/
platforms/macos/skey-app/dist/
