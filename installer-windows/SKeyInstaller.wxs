<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SKey - Vietnamese Input Method"
           Language="1033"
           Version="1.0.0"
           Manufacturer="SKey"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of SKey is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="SKeyIcon" SourceFile="skey-tray.exe" />
    <Property Id="ARPPRODUCTICON" Value="SKeyIcon" />

    <Feature Id="ProductFeature" Title="SKey">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <!-- Phase 5: register the TSF bridge DLL. The deferred system-context run
         writes the CLSID + TSF category (HKLM); the immediate impersonated
         run registers the "SKey Vietnamese" language profile (HKCU). -->
    <CustomAction Id="RegisterTsfSystem"
                  Directory="INSTALLFOLDER"
                  ExeCommand='[System64Folder]regsvr32.exe /s "[INSTALLFOLDER]skey-tsf.dll"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <CustomAction Id="RegisterTsfUser"
                  Directory="INSTALLFOLDER"
                  ExeCommand='[System64Folder]regsvr32.exe /s "[INSTALLFOLDER]skey-tsf.dll"'
                  Return="ignore" />
    <CustomAction Id="UnregisterTsfSystem"
                  Directory="INSTALLFOLDER"
                  ExeCommand='[System64Folder]regsvr32.exe /s /u "[INSTALLFOLDER]skey-tsf.dll"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RegisterTsfUser" After="InstallFiles" />
      <Custom Action="RegisterTsfSystem" After="RegisterTsfUser" />
      <Custom Action="UnregisterTsfSystem" Before="RemoveFiles" Condition='REMOVE="ALL"' />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SKey">
        <Component Id="ApplicationShortcut" Guid="*">
          <Shortcut Id="StartMenuShortcut"
                    Name="SKey Tray"
                    Description="SKey Vietnamese Input Method"
                    Target="[INSTALLFOLDER]skey-tray.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="SKeyIcon" />
          <RemoveFolder Id="CleanUpShortcut" On="uninstall" />
          <RegistryValue Root="HKCU"
                        Key="Software\SKey"
                        Name="installed"
                        Type="integer"
                        Value="1"
                        KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="skeytray.exe" Guid="*">
        <File Id="skey_tray.exe" Source="skey-tray.exe" KeyPath="yes" />
      </Component>
      <Component Id="skeytsf.dll" Guid="*">
        <File Id="skey_tsf.dll" Source="skey-tsf.dll" KeyPath="yes" />
      </Component>
      <Component Id="AppxManifest.xml" Guid="*">
        <File Id="AppxManifest.xml" Source="AppxManifest.xml" KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Package>
</Wix>
