<Window
    x:Class="SKey.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SKey - Cài đặt bộ gõ">

    <Grid x:Name="RootGrid">
        <NavigationView
            x:Name="RootNavigation"
            PaneDisplayMode="Left"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="250"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="RootNavigation_SelectionChanged">

            <NavigationView.PaneHeader>
                <Grid Margin="16,20,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                        <TextBlock Text="S" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="SKey Settings" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Bộ gõ tiếng Việt v0.1.0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="settings.nav.general" Content="Cài đặt chung" Icon="Setting" Tag="general" />
                <NavigationViewItem x:Uid="settings.nav.keyboard" Content="Bàn phím &amp; Kiểu gõ" Icon="Keyboard" Tag="keyboard" />
                <NavigationViewItem x:Uid="settings.nav.shortcuts" Content="Phím tắt nhanh" Icon="AllApps" Tag="shortcuts" />
                <NavigationViewItem x:Uid="settings.nav.snippets" Content="Gõ tắt (Macro)" Icon="Paste" Tag="snippets" />
                <NavigationViewItem x:Uid="settings.nav.clipboard" Content="Lịch sử Clipboard" Icon="Copy" Tag="clipboard" />
                <NavigationViewItem x:Uid="settings.nav.tools" Content="Công cụ tiện ích" Icon="Repair" Tag="tools" />
                <NavigationViewItem x:Uid="settings.nav.ai" Content="Trợ lý AI &amp; Dịch thuật" Icon="Favorite" Tag="ai" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="settings.nav.appearance" Content="Giao diện" Icon="FontColor" Tag="appearance" />
                <NavigationViewItem x:Uid="settings.nav.about" Content="Thông tin ứng dụng" Icon="Help" Tag="about" />
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Padding="28,24,28,24" />
        </NavigationView>
    </Grid>
</Window>
