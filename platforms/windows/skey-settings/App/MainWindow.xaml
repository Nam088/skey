<Window
    x:Class="SKey.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="settings.window"
    Title="SKey Settings">
    <NavigationView x:Name="RootNavigation" IsBackButtonVisible="Collapsed" SelectionChanged="RootNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Uid="settings.nav.general" Icon="Setting" Tag="general" />
            <NavigationViewItem x:Uid="settings.nav.keyboard" Icon="Keyboard" Tag="keyboard" />
            <NavigationViewItem x:Uid="settings.nav.shortcuts" Icon="AllApps" Tag="shortcuts" />
            <NavigationViewItem x:Uid="settings.nav.snippets" Icon="Paste" Tag="snippets" />
            <NavigationViewItem x:Uid="settings.nav.clipboard" Icon="Copy" Tag="clipboard" />
            <NavigationViewItem x:Uid="settings.nav.tools" Icon="Repair" Tag="tools" />
            <NavigationViewItem x:Uid="settings.nav.ai" Icon="Favorite" Tag="ai" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Uid="settings.nav.appearance" Icon="FontColor" Tag="appearance" />
            <NavigationViewItem x:Uid="settings.nav.about" Icon="Help" Tag="about" />
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
