<Window
    x:Class="SKey.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SKey Settings"
    Width="900" Height="680">
    <NavigationView x:Name="RootNavigation" IsBackButtonVisible="Collapsed" SelectionChanged="RootNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="{x:Bind ViewModel.GeneralTitle}" Tag="general" />
            <NavigationViewItem Content="{x:Bind ViewModel.KeyboardTitle}" Tag="keyboard" />
            <NavigationViewItem Content="{x:Bind ViewModel.ShortcutsTitle}" Tag="shortcuts" />
            <NavigationViewItem Content="{x:Bind ViewModel.SnippetsTitle}" Tag="snippets" />
            <NavigationViewItem Content="{x:Bind ViewModel.ClipboardTitle}" Tag="clipboard" />
            <NavigationViewItem Content="{x:Bind ViewModel.ToolsTitle}" Tag="tools" />
            <NavigationViewItem Content="AI" Tag="ai" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="{x:Bind ViewModel.AppearanceTitle}" Tag="appearance" />
            <NavigationViewItem Content="{x:Bind ViewModel.AboutTitle}" Tag="about" />
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
