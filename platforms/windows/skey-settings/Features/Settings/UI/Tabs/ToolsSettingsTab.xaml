<Page x:Class="SKey.Settings.ToolsSettingsTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch" Padding="4,4,28,48">
            <!-- Header -->
            <StackPanel Spacing="4" Margin="0,0,0,12">
                <TextBlock Text="Công cụ &amp; Tiện ích mở rộng" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Khóa vệ sinh bàn phím, biến đổi nhanh văn bản và chuyển đổi bảng mã tiếng Việt toàn diện" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
            </StackPanel>

            <!-- Vệ sinh bàn phím -->
            <TextBlock Text="Vệ sinh bàn phím (Keyboard Cleaner)" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,8,0,0" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="8" Background="{ThemeResource AccentFillColorTertiaryBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE90F;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Kích hoạt tính năng vệ sinh bàn phím" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Vô hiệu hóa toàn bộ phím tạm thời để bạn có thể lau chùi bàn phím an toàn" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="CleanerEnabledToggle" Grid.Column="2" VerticalAlignment="Center" Margin="0,-6,0,-6" IsOn="True" OnContent="Bật" OffContent="Tắt" Toggled="OnCleanerEnabledToggled" />
                    <Button Content="Bắt đầu vệ sinh ngay" Style="{StaticResource AccentButtonStyle}" Click="OnCleanNowClicked" Grid.Column="3" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Xử lý nhanh văn bản Clipboard -->
            <TextBlock Text="Biến đổi nhanh văn bản trong Clipboard" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,12,0,0" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Chuyển đổi trực tiếp nội dung đang có trong Clipboard" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Nhấn một nút bên dưới để tự động chuyển mã hoặc biến đổi kiểu chữ nội dung vừa sao chép" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Text="Chuyển đổi bảng mã tiếng Việt:" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Content="TCVN3 -&gt; Unicode" Tag="tcvn3ToUnicode" Click="OnQuickTransformClicked" HorizontalAlignment="Stretch" Padding="12,8" />
                        <Button Grid.Column="1" Content="Unicode -&gt; TCVN3" Tag="unicodeToTcvn3" Click="OnQuickTransformClicked" HorizontalAlignment="Stretch" Padding="12,8" />
                        <Button Grid.Row="1" Content="VNI -&gt; Unicode" Tag="vniToUnicode" Click="OnQuickTransformClicked" HorizontalAlignment="Stretch" Padding="12,8" />
                        <Button Grid.Row="1" Grid.Column="1" Content="Unicode -&gt; VNI" Tag="unicodeToVni" Click="OnQuickTransformClicked" HorizontalAlignment="Stretch" Padding="12,8" />
                    </Grid>

                    <TextBlock Text="Đổi kiểu chữ &amp; Dấu thanh:" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Content="CHỮ HOA (UPPERCASE)" Tag="toUppercase" Click="OnQuickTransformClicked" HorizontalAlignment="Stretch" Padding="12,8" />
                        <Button Grid.Column="1" Content="chữ thường (lowercase)" Tag="toLowercase" Click="OnQuickTransformClicked" HorizontalAlignment="Stretch" Padding="12,8" />
                        <Button Grid.Row="1" Content="Viết Hoa Đầu Từ (Title Case)" Tag="toTitleCase" Click="OnQuickTransformClicked" HorizontalAlignment="Stretch" Padding="12,8" />
                        <Button Grid.Row="1" Grid.Column="1" Content="Loại bỏ dấu tiếng Việt (Khong dau)" Tag="removeTones" Click="OnQuickTransformClicked" HorizontalAlignment="Stretch" Padding="12,8" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bộ chuyển đổi mã chi tiết -->
            <TextBlock Text="Bộ chuyển đổi mã toàn diện" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,12,0,0" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ConverterSourceCombo" Header="Bảng mã nguồn" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="TCVN3 (ABC)" />
                            <ComboBoxItem Content="VNI Windows" />
                            <ComboBoxItem Content="Unicode" />
                        </ComboBox>
                        <ComboBox x:Name="ConverterTargetCombo" Grid.Column="1" Header="Bảng mã đích" SelectedIndex="2" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="TCVN3 (ABC)" />
                            <ComboBoxItem Content="VNI Windows" />
                            <ComboBoxItem Content="Unicode" />
                        </ComboBox>
                    </Grid>
                    <TextBox x:Name="ConverterInputBox" Header="Nội dung cần chuyển đổi" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" PlaceholderText="Nhập hoặc dán văn bản cần chuyển đổi mã vào đây..." />
                    <Button Content="Thực hiện chuyển đổi" Style="{StaticResource AccentButtonStyle}" Click="OnConvertClicked" HorizontalAlignment="Right" Padding="20,6" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
