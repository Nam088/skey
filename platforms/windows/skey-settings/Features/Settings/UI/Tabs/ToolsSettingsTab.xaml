<Page x:Class="SKey.Settings.ToolsSettingsTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded">
  <ScrollViewer>
    <StackPanel Spacing="16" Padding="0,0,0,24">
      <TextBlock x:Uid="settings.tools.title" Text="Tools" Style="{StaticResource SubtitleTextBlockStyle}"/>

      <Border Padding="20,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock x:Uid="settings.cleaner.title" Text="Keyboard cleaner" Style="{StaticResource BodyStrongTextBlockStyle}"/>
          <TextBlock x:Uid="cleaner.desc" Text="Locks the keyboard temporarily so you can wipe it clean without triggering shortcuts or typing." TextWrapping="Wrap" Opacity="0.7"/>
          <ToggleSwitch x:Name="CleanerEnabledToggle" x:Uid="tools.cleaner.enabled" Header="Enable keyboard cleaner" IsOn="True" Toggled="OnCleanerEnabledToggled"/>
          <Button x:Uid="cleaner.action.start" Content="Start cleaning" Click="OnCleanNowClicked"/>
        </StackPanel>
      </Border>

      <Border Padding="20,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock x:Uid="tools.section.quickText" Text="Quick text tools" Style="{StaticResource BodyStrongTextBlockStyle}"/>
          <TextBlock x:Uid="tools.quickText.desc" Text="Transform the current clipboard text in one click." TextWrapping="Wrap" Opacity="0.7"/>
          <TextBlock x:Uid="tools.quick.encodingHeader" Text="Encoding" FontWeight="SemiBold" FontSize="12" Opacity="0.7"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Uid="tools.action.tcvn3ToUnicode" Content="TCVN3 → Unicode" Tag="tcvn3ToUnicode" Click="OnQuickTransformClicked"/>
            <Button x:Uid="tools.action.unicodeToTcvn3" Content="Unicode → TCVN3" Tag="unicodeToTcvn3" Click="OnQuickTransformClicked"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Uid="tools.action.vniToUnicode" Content="VNI → Unicode" Tag="vniToUnicode" Click="OnQuickTransformClicked"/>
            <Button x:Uid="tools.action.unicodeToVni" Content="Unicode → VNI" Tag="unicodeToVni" Click="OnQuickTransformClicked"/>
          </StackPanel>
          <TextBlock x:Uid="tools.quick.caseHeader" Text="Case &amp; tones" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Uid="tools.action.toUppercase" Content="UPPERCASE" Tag="toUppercase" Click="OnQuickTransformClicked"/>
            <Button x:Uid="tools.action.toLowercase" Content="lowercase" Tag="toLowercase" Click="OnQuickTransformClicked"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Uid="tools.action.toTitleCase" Content="Title Case" Tag="toTitleCase" Click="OnQuickTransformClicked"/>
            <Button x:Uid="tools.action.removeTones" Content="Remove tones" Tag="removeTones" Click="OnQuickTransformClicked"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Padding="20,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock x:Uid="tools.section.converter" Text="Text converter" Style="{StaticResource BodyStrongTextBlockStyle}"/>
          <TextBlock x:Uid="tools.converter.desc" Text="Convert text between Vietnamese character encodings (Unicode, TCVN3, VNI Windows)." TextWrapping="Wrap" Opacity="0.7"/>
          <ComboBox x:Name="ConverterSourceCombo" x:Uid="tools.converter.source" Header="Source encoding" SelectedIndex="0" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="TCVN3 (ABC)"/>
            <ComboBoxItem Content="VNI Windows"/>
            <ComboBoxItem Content="Unicode"/>
          </ComboBox>
          <ComboBox x:Name="ConverterTargetCombo" x:Uid="tools.converter.target" Header="Target encoding" SelectedIndex="2" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="TCVN3 (ABC)"/>
            <ComboBoxItem Content="VNI Windows"/>
            <ComboBoxItem Content="Unicode"/>
          </ComboBox>
          <TextBox x:Name="ConverterInputBox" x:Uid="tools.converter.input" Header="Input text" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
          <Button x:Uid="tools.converter.convert" Content="Convert" Click="OnConvertClicked"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
