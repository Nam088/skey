<Page x:Class="SKey.Settings.AboutSettingsTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Spacing="16" Padding="0,0,0,24">
      <TextBlock Text="About SKey" Style="{StaticResource SubtitleTextBlockStyle}"/>

      <Border Padding="24,20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
          <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource SKeyAccentBrush}" HorizontalAlignment="Center">
            <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" FontWeight="Bold" Foreground="White"/>
          </Border>
          <TextBlock Text="SKey" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="Vietnamese input method for Windows" HorizontalAlignment="Center" Opacity="0.7"/>
          <TextBlock HorizontalAlignment="Center">
            <Run Text="Version "/><Run Text="0.1.0"/>
          </TextBlock>
        </StackPanel>
      </Border>

      <TextBlock Text="Credits" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
      <StackPanel Spacing="4">
        <TextBlock>
          <Run Text="Built with "/><Run Text="Rust" FontWeight="SemiBold"/><Run Text=" + "/><Run Text="C++/WinRT" FontWeight="SemiBold"/>
        </TextBlock>
        <TextBlock>
          <Run Text="Input engine: "/><Run Text="UniKey" FontWeight="SemiBold"/>
        </TextBlock>
        <TextBlock>
          <Run Text="Framework: "/><Run Text="Windows TSF (Text Services Framework)" FontWeight="SemiBold"/>
        </TextBlock>
      </StackPanel>

      <TextBlock Text="Links" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
      <StackPanel Spacing="8">
        <HyperlinkButton Content="GitHub Repository"/>
        <HyperlinkButton Content="Report a Bug"/>
        <HyperlinkButton Content="License (MIT)"/>
      </StackPanel>

      <TextBlock Text="System Information" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
      <Grid ColumnSpacing="12" RowSpacing="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Windows version" Opacity="0.7"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Windows 10/11"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="IME status" Opacity="0.7"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Registered"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Architecture" Opacity="0.7"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="x64"/>
      </Grid>

      <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.5" Margin="0,16,0,0">© 2024 SKey Contributors. Licensed under MIT.</TextBlock>
    </StackPanel>
  </ScrollViewer>
</Page>
