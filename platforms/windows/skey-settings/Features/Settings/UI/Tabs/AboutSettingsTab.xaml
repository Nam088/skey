<Page x:Class="SKey.Settings.AboutSettingsTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded">
  <ScrollViewer>
    <StackPanel Spacing="16" Padding="0,0,0,24">
      <TextBlock x:Uid="settings.about.title" Text="About SKey" Style="{StaticResource SubtitleTextBlockStyle}"/>

      <Border Padding="24,20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
          <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource SKeyAccentBrush}" HorizontalAlignment="Center">
            <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32" FontWeight="Bold" Foreground="White"/>
          </Border>
          <TextBlock Text="SKey" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock HorizontalAlignment="Center" Opacity="0.7">
            <Run x:Uid="about.version.label" Text="Version "/><Run Text="0.1.0"/>
          </TextBlock>
          <TextBlock x:Uid="about.description" Text="Bộ gõ tiếng Việt dành cho Windows" HorizontalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Padding="20,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="8">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Uid="about.author" Text="Author" Opacity="0.7"/>
            <TextBlock Grid.Column="1" Text="Nam088"/>
          </Grid>
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Uid="about.opensource" Text="Open source" Opacity="0.7"/>
            <HyperlinkButton Grid.Column="1" Content="GitHub" NavigateUri="https://github.com/Nam088/skey" Padding="0"/>
          </Grid>
        </StackPanel>
      </Border>

      <Button x:Name="CheckUpdatesButton" x:Uid="about.checkUpdateBtn" Content="Check for updates" Click="OnCheckUpdatesClicked"/>

      <TextBlock x:Uid="about.copyright" Text="© 2024 SKey Contributors. Licensed under MIT." TextWrapping="Wrap" FontSize="12" Opacity="0.5" Margin="0,16,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Page>
