<Page x:Class="SKey.Settings.SnippetsSettingsTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Spacing="16" Padding="0,0,0,24">
      <TextBlock Text="Snippets" Style="{StaticResource SubtitleTextBlockStyle}"/>

      <TextBlock TextWrapping="Wrap" Opacity="0.7">Define text shortcuts that expand automatically as you type. For example, type "vn" and it expands to "Việt Nam".</TextBlock>

      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Header="Abbreviation" PlaceholderText="e.g. vn"/>
        <TextBox Grid.Column="1" Header="Expansion" PlaceholderText="e.g. Việt Nam"/>
        <Button Grid.Column="2" Content="Add" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"/>
      </Grid>

      <TextBlock Text="Saved Snippets" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>

      <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="4">
          <TextBlock Text="No snippets configured" Opacity="0.7" HorizontalAlignment="Center" Padding="0,16"/>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Import snippets"/>
        <Button Content="Export snippets"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
