<Page x:Class="SKey.Settings.AppearanceSettingsTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded">
  <ScrollViewer>
    <StackPanel Spacing="16" Padding="0,0,0,24">
      <TextBlock x:Uid="settings.appearance.title" Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}"/>

      <TextBlock x:Uid="settings.theme" Text="Theme" Style="{StaticResource BodyStrongTextBlockStyle}"/>
      <RadioButtons x:Name="ThemeOptions" SelectedIndex="0">
        <RadioButton x:Name="ThemeSystemRadio" x:Uid="settings.theme.system" Content="System" GroupName="Theme" IsChecked="True" Checked="OnThemeSystemChecked"/>
        <RadioButton x:Name="ThemeLightRadio" x:Uid="settings.theme.light" Content="Light" GroupName="Theme" Checked="OnThemeLightChecked"/>
        <RadioButton x:Name="ThemeDarkRadio" x:Uid="settings.theme.dark" Content="Dark" GroupName="Theme" Checked="OnThemeDarkChecked"/>
      </RadioButtons>
    </StackPanel>
  </ScrollViewer>
</Page>
