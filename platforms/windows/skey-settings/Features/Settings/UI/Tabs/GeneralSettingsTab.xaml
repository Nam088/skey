<Page x:Class="SKey.Settings.GeneralSettingsTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Spacing="16" Padding="0,0,0,24">
      <TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}"/>

      <TextBlock Text="Basic" Style="{StaticResource BodyStrongTextBlockStyle}"/>
      <ToggleSwitch Header="Launch at startup"/>
      <ToggleSwitch Header="Check for updates" IsOn="True"/>
      <ComboBox Header="App language" SelectedIndex="0" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="Tiếng Việt"/>
        <ComboBoxItem Content="English"/>
      </ComboBox>

      <TextBlock Text="Data" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Export settings"/>
        <Button Content="Import settings"/>
      </StackPanel>
      <ToggleSwitch Header="Debug mode"/>
      <Button Content="Factory reset" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
    </StackPanel>
  </ScrollViewer>
</Page>
