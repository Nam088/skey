<Page x:Class="SKey.Settings.AiSettingsTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Spacing="16" Padding="0,0,0,24">
      <TextBlock Text="AI Assistant" Style="{StaticResource SubtitleTextBlockStyle}"/>

      <Border Padding="20,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="AI-powered suggestions" Style="{StaticResource BodyStrongTextBlockStyle}"/>
          <TextBlock TextWrapping="Wrap" Opacity="0.7">Enable intelligent word prediction and auto-completion for faster Vietnamese typing. Requires an API key.</TextBlock>
        </StackPanel>
      </Border>

      <ToggleSwitch Header="Enable AI suggestions"/>
      <ToggleSwitch Header="Auto-complete words"/>
      <ToggleSwitch Header="Learn from corrections"/>

      <TextBlock Text="API Configuration" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
      <PasswordBox Header="API Key" PlaceholderText="Enter your API key"/>
      <ComboBox Header="Model" SelectedIndex="0" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="Default"/>
        <ComboBoxItem Content="Fast (low latency)"/>
        <ComboBoxItem Content="Accurate (higher quality)"/>
      </ComboBox>

      <TextBlock Text="Privacy" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
      <ToggleSwitch Header="Send anonymous usage data" IsOn="True"/>
      <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6">Anonymous data helps improve suggestion quality. No personal typing content is ever sent.</TextBlock>
    </StackPanel>
  </ScrollViewer>
</Page>
