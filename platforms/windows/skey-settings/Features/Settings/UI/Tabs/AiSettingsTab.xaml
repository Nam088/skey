<Page x:Class="SKey.Settings.AiSettingsTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded">
  <ScrollViewer>
    <StackPanel Spacing="16" Padding="0,0,0,24">
      <TextBlock x:Uid="settings.ai.title" Text="AI" Style="{StaticResource SubtitleTextBlockStyle}"/>

      <TextBlock x:Uid="ai.section.provider" Text="Provider" Style="{StaticResource BodyStrongTextBlockStyle}"/>
      <ComboBox x:Name="PreferredEngineCombo" x:Uid="ai.option.service" Header="Translation service" SelectedIndex="0" SelectionChanged="OnPreferredEngineChanged" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="Google Translate"/>
        <ComboBoxItem Content="Apple Translate"/>
        <ComboBoxItem Content="Gemini"/>
        <ComboBoxItem Content="DeepL"/>
        <ComboBoxItem Content="Groq"/>
      </ComboBox>
      <PasswordBox x:Name="PreferredEngineApiKeyBox" x:Uid="ai.option.apiKey" Header="API key" PlaceholderText="sk-..." PasswordChanged="OnPreferredEngineApiKeyChanged"/>

      <TextBlock x:Uid="settings.subtab.translator" Text="Translation" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
      <ComboBox x:Name="TargetLanguageCombo" x:Uid="tools.translator.targetLang" Header="Target language" SelectedIndex="0" SelectionChanged="OnTargetLanguageChanged" HorizontalAlignment="Stretch">
        <ComboBoxItem x:Uid="lang.vi" Content="Vietnamese"/>
        <ComboBoxItem x:Uid="lang.en" Content="English"/>
        <ComboBoxItem x:Uid="lang.ja" Content="Japanese"/>
        <ComboBoxItem x:Uid="lang.zh" Content="Chinese"/>
        <ComboBoxItem x:Uid="lang.ko" Content="Korean"/>
        <ComboBoxItem x:Uid="lang.fr" Content="French"/>
        <ComboBoxItem x:Uid="lang.de" Content="German"/>
      </ComboBox>
      <ToggleSwitch x:Name="AutoDetectToggle" x:Uid="tools.translator.autoDetect" Header="Auto-detect source language" IsOn="True" Toggled="OnAutoDetectToggled"/>

      <TextBlock x:Uid="settings.subtab.aiModel" Text="Engines" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
      <StackPanel Spacing="10">
        <StackPanel Spacing="4">
          <ToggleSwitch x:Name="EngineGoogleToggle" Header="Google Translate" IsOn="True" Tag="google" Toggled="OnEngineEnabledToggled"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <ToggleSwitch x:Name="EngineAppleToggle" Header="Apple Translate" IsOn="True" Tag="apple" Toggled="OnEngineEnabledToggled"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <ToggleSwitch x:Name="EngineGeminiToggle" Header="Gemini" IsOn="True" Tag="gemini" Toggled="OnEngineEnabledToggled"/>
          <PasswordBox x:Name="EngineGeminiApiKeyBox" x:Uid="ai.option.engineApiKey" PlaceholderText="API key" Tag="gemini" PasswordChanged="OnEngineApiKeyChanged" Margin="0,0,0,0"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <ToggleSwitch x:Name="EngineDeeplToggle" Header="DeepL" IsOn="True" Tag="deepl" Toggled="OnEngineEnabledToggled"/>
          <PasswordBox x:Name="EngineDeeplApiKeyBox" x:Uid="ai.option.engineApiKey" PlaceholderText="API key" Tag="deepl" PasswordChanged="OnEngineApiKeyChanged"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <ToggleSwitch x:Name="EngineGroqToggle" Header="Groq" IsOn="True" Tag="groq" Toggled="OnEngineEnabledToggled"/>
          <PasswordBox x:Name="EngineGroqApiKeyBox" x:Uid="ai.option.engineApiKey" PlaceholderText="API key" Tag="groq" PasswordChanged="OnEngineApiKeyChanged"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
