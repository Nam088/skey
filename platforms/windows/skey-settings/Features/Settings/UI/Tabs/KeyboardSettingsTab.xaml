<Page x:Class="SKey.Settings.KeyboardSettingsTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded">
  <ScrollViewer>
    <StackPanel Spacing="16" Padding="0,0,0,24">
      <TextBlock x:Uid="settings.keyboard.title" Text="Keyboard" Style="{StaticResource SubtitleTextBlockStyle}"/>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="SubTabInputMethod" x:Uid="settings.subtab.inputMethod" Content="Input Method" Click="OnSubTabInputMethodClicked"/>
        <Button x:Name="SubTabTypingRules" x:Uid="settings.subtab.typingRules" Content="Typing Rules" Click="OnSubTabTypingRulesClicked"/>
        <Button x:Name="SubTabAppManagement" x:Uid="settings.subtab.appManagement" Content="App Management" Click="OnSubTabAppManagementClicked"/>
      </StackPanel>

      <StackPanel x:Name="InputMethodPanel" Spacing="12">
        <TextBlock x:Uid="settings.keyboard.input_method" Text="Input Method" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <ComboBox x:Name="InputMethodCombo" x:Uid="keyboard.option.primaryMethod" Header="Primary input method" SelectedIndex="0" SelectionChanged="OnInputMethodChanged" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Telex"/>
          <ComboBoxItem Content="Simple Telex"/>
          <ComboBoxItem Content="VNI"/>
          <ComboBoxItem Content="VIQR"/>
        </ComboBox>
        <TextBlock x:Uid="keyboard.option.primaryMethodDesc" Text="Default Vietnamese typing method" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ComboBox x:Name="CharsetCombo" x:Uid="keyboard.option.charset" Header="Charset" SelectedIndex="0" SelectionChanged="OnCharsetChanged" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Unicode"/>
          <ComboBoxItem Content="TCVN3"/>
          <ComboBoxItem Content="VNI Windows"/>
        </ComboBox>
        <TextBlock x:Uid="keyboard.option.charsetDesc" Text="Output character encoding" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <TextBlock x:Uid="keyboard.section.mode" Text="Typing Mode" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
        <ToggleSwitch x:Name="VietnameseToggle" x:Uid="keyboard.option.enableVietnamese" Header="Enable Vietnamese input" IsOn="True" Toggled="OnVietnameseToggled"/>
        <TextBlock x:Uid="keyboard.option.enableVietnameseDesc" Text="Turn the Vietnamese input engine on or off" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Uid="keyboard.shortcut.toggleTitle" Text="Language toggle shortcut"/>
            <TextBlock x:Uid="keyboard.shortcut.toggleSubtitle" Text="Quickly switch between Vietnamese and English" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
          <TextBlock Grid.Column="1" x:Name="LanguageToggleHotkeyText" Text="Alt+Z" Style="{StaticResource CaptionTextBlockStyle}" Padding="8,4" VerticalAlignment="Center" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
          <ComboBox Grid.Column="2" x:Name="LanguageTogglePresetCombo" x:Uid="shortcut.presets" SelectionChanged="OnLanguageTogglePresetChanged" SelectedIndex="0" VerticalAlignment="Center" MinWidth="160">
            <ComboBoxItem Content="Alt + Z"/>
            <ComboBoxItem Content="Ctrl + Shift"/>
            <ComboBoxItem Content="Ctrl + Alt + Z"/>
            <ComboBoxItem Content="Shift + Win"/>
            <ComboBoxItem Content="Alt + Shift"/>
            <ComboBoxItem Content="Ctrl + Space"/>
          </ComboBox>
        </Grid>
      </StackPanel>

      <StackPanel x:Name="TypingRulesPanel" Spacing="12" Visibility="Collapsed">
        <TextBlock x:Uid="keyboard.section.rules" Text="Typing Rules &amp; Tone Marks" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <ToggleSwitch x:Name="SpellCheckToggle" x:Uid="settings.keyboard.spell_check" Header="Spell check" IsOn="True" Toggled="OnSpellCheckToggled"/>
        <TextBlock x:Uid="keyboard.option.spellCheckDesc" Text="Automatically undo tone marks for words not in the Vietnamese dictionary" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ToggleSwitch x:Name="FreeMarkingToggle" x:Uid="keyboard.options.free_marking" Header="Free marking" IsOn="True" Toggled="OnFreeMarkingToggled"/>
        <TextBlock x:Uid="keyboard.option.freeMarkingDesc" Text="Allow tone marks at any position in a word (e.g. toanf -&gt; toàn)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ToggleSwitch x:Name="ModernStyleToggle" x:Uid="keyboard.options.modern_style" Header="Modern tone mark style" Toggled="OnModernStyleToggled"/>
        <TextBlock x:Uid="keyboard.option.modernStyleDesc" Text="Place tone marks on the second vowel instead of the traditional style" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ToggleSwitch x:Name="SwallowedKeyRestoreToggle" x:Uid="keyboard.advanced.swallowed_restore" Header="Restore swallowed keystrokes" IsOn="True" Toggled="OnSwallowedKeyRestoreToggled"/>
        <TextBlock x:Uid="keyboard.option.swallowedKeyDesc" Text="Recover characters wrongly deleted when switching to an English word" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ToggleSwitch x:Name="ZfwjToggle" x:Uid="keyboard.options.allow_zfwj" Header="Allow z/f/w/j as consonants" Toggled="OnZfwjToggled"/>
        <TextBlock x:Uid="keyboard.option.zfwjDesc" Text="Treat z, f, w, j as real consonants instead of Telex tone shortcuts" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <TextBlock x:Uid="keyboard.section.quickTelex" Text="Quick Typing" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
        <ToggleSwitch x:Name="QuickTelexToggle" x:Uid="keyboard.advanced.quick_telex" Header="Quick Telex (cc=ch, gg=gi, uu=uo)" Toggled="OnQuickTelexToggled"/>
        <TextBlock x:Uid="keyboard.option.quickTelexDesc" Text="Auto replace cc-&gt;ch, gg-&gt;gi, uu-&gt;ươ, tt-&gt;th" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ToggleSwitch x:Name="QuickStartConsonantToggle" x:Uid="keyboard.option.quickStartConsonant" Header="Quick start consonant (f=ph, j=gi, w=qu)" Toggled="OnQuickStartConsonantToggled"/>
        <TextBlock x:Uid="keyboard.option.quickStartConsonantDesc" Text="Auto replace f-&gt;ph, j-&gt;gi, w-&gt;qu" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ToggleSwitch x:Name="QuickEndConsonantToggle" x:Uid="keyboard.option.quickEndConsonant" Header="Quick end consonant (g=ng, h=nh, k=ch)" Toggled="OnQuickEndConsonantToggled"/>
        <TextBlock x:Uid="keyboard.option.quickEndConsonantDesc" Text="Auto replace g-&gt;ng, h-&gt;nh, k-&gt;ch" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ToggleSwitch x:Name="UpperCaseFirstToggle" x:Uid="keyboard.option.upperCaseFirst" Header="Upper case first character" Toggled="OnUpperCaseFirstCharToggled"/>
        <TextBlock x:Uid="keyboard.option.upperCaseFirstDesc" Text="Auto capitalize the letter after punctuation (. ? !)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>

      <StackPanel x:Name="AppManagementPanel" Spacing="12" Visibility="Collapsed">
        <TextBlock x:Uid="keyboard.section.smartSwitch" Text="Smart Environment Switching" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <ToggleSwitch x:Name="SmartAppSwitchToggle" x:Uid="keyboard.option.smartSwitch" Header="Enable Smart App Switch" Toggled="OnSmartAppSwitchToggled"/>
        <TextBlock x:Uid="keyboard.option.smartSwitchDesc" Text="Auto switch to English in IDE / Terminal and restore when switching back" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ToggleSwitch x:Name="ImeBrowsersToggle" x:Uid="keyboard.option.imeBrowsers" Header="Use IME for browsers" IsOn="True" Toggled="OnImeBrowsersToggled"/>
        <TextBlock x:Uid="keyboard.option.imeBrowsersDesc" Text="Type through the TSF bridge in Chrome/Edge/Firefox so address bars never double characters" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <TextBlock x:Uid="keyboard.section.excludedApps" Text="Excluded Applications" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0"/>
        <ToggleSwitch x:Name="ExclusionEnabledToggle" x:Uid="keyboard.excluded.enableMaster" Header="Enable app exclusion" IsOn="True" Toggled="OnExclusionEnabledToggled"/>
        <TextBlock x:Uid="keyboard.excluded.enableMasterDesc" Text="Automatically bypass the Vietnamese engine in selected applications" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="AddExcludedAppBox" x:Uid="keyboard.excluded.processNamePlaceholder" PlaceholderText="notepad.exe" MinWidth="220"/>
          <Button x:Name="AddExcludedAppButton" x:Uid="keyboard.excluded.addApp" Content="Add application" Click="OnAddExcludedAppClicked"/>
          <Button x:Name="RemoveExcludedAppButton" x:Uid="keyboard.excluded.removeSelected" Content="Remove selected" Click="OnRemoveSelectedExcludedAppClicked"/>
          <Button x:Name="ClearExcludedAppsButton" x:Uid="keyboard.excluded.clearAll" Content="Clear all" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Click="OnClearExcludedAppsClicked"/>
        </StackPanel>
        <TextBlock x:Name="ExcludedAppsCountText" x:Uid="keyboard.excluded.noApps" Text="No excluded applications" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ListView x:Name="ExcludedAppsList" SelectionMode="Single" MinHeight="160" MaxHeight="280"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
