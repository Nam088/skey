{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SKey local IPC envelope",
  "type": "object",
  "required": ["protocolVersion", "requestId", "method"],
  "properties": {
    "protocolVersion": {"type": "integer", "const": 1},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 64},
    "method": {"type": "string", "minLength": 1, "maxLength": 64},
    "payload": {},
    "deadlineMs": {"type": "integer", "minimum": 1, "maximum": 30000}
  },
  "additionalProperties": false
}
